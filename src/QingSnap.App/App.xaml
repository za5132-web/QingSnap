<Application x:Class="QingSnap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QingSnap.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
            <FontFamily x:Key="DataFont">Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
