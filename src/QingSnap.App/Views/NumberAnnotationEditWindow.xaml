<Window x:Class="QingSnap.App.Views.NumberAnnotationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:QingSnap.App.Controls"
        Title="修改序号"
        Width="336"
        Height="206"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource ThemeHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" Background="{DynamicResource ThemePopupBrush}" BorderBrush="{DynamicResource ThemeBorderStrongBrush}" BorderThickness="1" CornerRadius="9">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.55" Color="#FF000000" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource ThemeChromeBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <TextBlock Margin="16,0" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" Text="修改序号" />
                    <Button Width="42" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeMutedTextBrush}" Cursor="Hand" Click="OnCancelClick">
                        <icons:QingSnapIcon Kind="Close" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,14,18,8">
                <TextBlock FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Text="输入新的标注数字（1–9999）" />
                <TextBox x:Name="NumberBox"
                         Height="36"
                         Margin="0,7,0,0"
                         Padding="10,5"
                         FontFamily="Consolas"
                         FontSize="15"
                         Foreground="{DynamicResource ThemeTextBrush}"
                         CaretBrush="{DynamicResource ThemeAccentBrush}"
                         Background="{DynamicResource ThemeFieldBrush}"
                         BorderBrush="{DynamicResource ThemeBorderStrongBrush}"
                         BorderThickness="1" />
                <TextBlock x:Name="ErrorText" Margin="0,5,0,0" FontFamily="Microsoft YaHei UI" FontSize="10.5" Foreground="{DynamicResource ThemeDangerBrush}" />
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource ThemeChromeBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <StackPanel Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButton}" Content="取消" Click="OnCancelClick" />
                    <Button Style="{StaticResource DialogButton}" Template="{DynamicResource ThemePrimaryButtonTemplate}" Background="{DynamicResource ThemeAccentBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeOnAccentBrush}" Content="确认" Click="OnConfirmClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
