<Window x:Class="QingSnap.App.Views.StickyImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QingSnap 贴图"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF070B0E"
        Foreground="#FFF3F7F9"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
        <Style x:Key="PinContextMenu" TargetType="ContextMenu">
            <Setter Property="Width" Value="220" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="5"
                                Background="#F70D171E"
                                BorderBrush="#6676DFEE"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF000000"
                                                  BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Opacity="0.55" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="#FFEAF1F4" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChrome"
                                Margin="0,1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent"
                                        Width="3"
                                        Background="#FF76DFEE"
                                        CornerRadius="2"
                                        Opacity="0" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="11,0,14,0"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                                <TextBlock Grid.Column="2"
                                           Margin="0,0,11,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource DataFont}"
                                           FontSize="10"
                                           FontWeight="Normal"
                                           Foreground="#FF8FA0AA"
                                           Text="{TemplateBinding InputGestureText}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#FF22333D" />
                                <Setter TargetName="Accent" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinMenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="7" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="12,3"
                                Background="#334D5C65" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame"
            Background="#FF070B0E"
            BorderBrush="#FF76DFEE"
            BorderThickness="1">
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource PinContextMenu}">
                <MenuItem Header="复制图片"
                          InputGestureText="Ctrl+C"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnCopyClick" />
                <Separator Style="{StaticResource PinMenuSeparator}" />
                <MenuItem x:Name="TopMenuItem"
                          Header="回到顶部"
                          InputGestureText="Home"
                          Style="{StaticResource PinMenuItem}"
                          Visibility="Collapsed"
                          Click="OnTopClick" />
                <MenuItem x:Name="OverviewMenuItem"
                          Header="完整概览"
                          InputGestureText="双击"
                          Style="{StaticResource PinMenuItem}"
                          Visibility="Collapsed"
                          Click="OnOverviewClick" />
                <MenuItem x:Name="ReaderModeMenuItem"
                          Header="长图阅读窗"
                          InputGestureText="双击"
                          Style="{StaticResource PinMenuItem}"
                          Visibility="Collapsed"
                          Click="OnReaderModeClick" />
                <MenuItem x:Name="FitMenuItem"
                          Header="适应屏幕"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnFitClick" />
                <MenuItem x:Name="ActualSizeMenuItem"
                          Header="原始大小  1:1"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnActualSizeClick" />
                <Separator Style="{StaticResource PinMenuSeparator}" />
                <MenuItem Header="关闭贴图"
                          InputGestureText="Esc"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnCloseClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid ClipToBounds="True">
            <Image x:Name="PinnedImage"
                   Stretch="Fill"
                   SnapsToDevicePixels="True"
                   MouseLeftButtonDown="OnImageMouseLeftButtonDown" />

            <Canvas x:Name="TextSelectionOverlay"
                    Visibility="Collapsed"
                    Background="Transparent"
                    Cursor="SizeAll"
                    ClipToBounds="True"
                    SizeChanged="OnTextOverlaySizeChanged"
                    MouseLeftButtonDown="OnTextOverlayMouseLeftButtonDown"
                    MouseMove="OnTextOverlayMouseMove"
                    MouseLeftButtonUp="OnTextOverlayMouseLeftButtonUp"
                    MouseLeave="OnTextOverlayMouseLeave" />

            <ScrollViewer x:Name="LongImageScroller"
                          Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          PanningMode="Both"
                          ScrollChanged="OnLongImageScrollChanged">
                <Grid x:Name="LongImageSurface"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Image x:Name="LongPinnedImage"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           MouseLeftButtonDown="OnImageMouseLeftButtonDown" />
                    <Canvas x:Name="LongTextSelectionOverlay"
                            Visibility="Collapsed"
                            Background="Transparent"
                            Cursor="SizeAll"
                            ClipToBounds="True"
                            SizeChanged="OnTextOverlaySizeChanged"
                            MouseLeftButtonDown="OnTextOverlayMouseLeftButtonDown"
                            MouseMove="OnTextOverlayMouseMove"
                            MouseLeftButtonUp="OnTextOverlayMouseLeftButtonUp"
                            MouseLeave="OnTextOverlayMouseLeave" />
                </Grid>
            </ScrollViewer>

            <Grid x:Name="ScrollRail"
                  Width="4"
                  Margin="0,8,5,8"
                  HorizontalAlignment="Right"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  SizeChanged="OnScrollRailSizeChanged">
                <Border Background="#4D07151B" CornerRadius="2" />
                <Border x:Name="ScrollThumb"
                        Height="36"
                        VerticalAlignment="Top"
                        Background="#E676DFEE"
                        CornerRadius="2">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <Border x:Name="FeedbackBadge"
                    Margin="0,0,0,12"
                    Padding="10,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#ED10222A"
                    BorderBrush="#9976DFEE"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="Collapsed">
                <TextBlock x:Name="FeedbackText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FFF3F7F9" />
            </Border>
        </Grid>
    </Border>
</Window>
