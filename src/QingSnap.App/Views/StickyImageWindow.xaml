<Window x:Class="QingSnap.App.Views.StickyImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:QingSnap.App.Controls"
        Title="QingSnap 贴图"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="{DynamicResource ThemeImageBackdropBrush}"
        Foreground="{DynamicResource ThemeTextBrush}"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
        <Style x:Key="PinAnnotationButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinContextMenu" TargetType="ContextMenu">
            <Setter Property="Width" Value="220" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="5"
                                Background="{DynamicResource ThemeOverlayPanelBrush}"
                                BorderBrush="{DynamicResource ThemeBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF000000"
                                                  BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Opacity="0.55" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChrome"
                                Margin="0,1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent"
                                        Width="3"
                                        Background="{DynamicResource ThemeAccentBrush}"
                                        CornerRadius="2"
                                        Opacity="0" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="11,0,14,0"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                                <TextBlock Grid.Column="2"
                                           Margin="0,0,11,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource DataFont}"
                                           FontSize="10"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                                           Text="{TemplateBinding InputGestureText}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter TargetName="Accent" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinMenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="7" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="12,3"
                                Background="{DynamicResource ThemeBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2C84552" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFF8A94" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE45764" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            Background="{DynamicResource ThemeImageBackdropBrush}"
            BorderBrush="{DynamicResource ThemeAccentBrush}"
            BorderThickness="1">
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource PinContextMenu}">
                <MenuItem Header="复制图片"
                          InputGestureText="Ctrl+C"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnCopyClick" />
                <MenuItem x:Name="AnnotateMenuItem" Header="标注图片"
                          InputGestureText="F2" Style="{StaticResource PinMenuItem}"
                          Click="OnAnnotateClick" />
                <MenuItem Header="另存图片" Style="{StaticResource PinMenuItem}"
                          Click="OnSaveAnnotatedClick" />
                <MenuItem Header="识别二维码"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnRecognizeQrCodeClick" />
                <Separator Style="{StaticResource PinMenuSeparator}" />
                <MenuItem x:Name="TopMenuItem"
                          Header="回到顶部"
                          InputGestureText="Home"
                          Style="{StaticResource PinMenuItem}"
                          Visibility="Collapsed"
                          Click="OnTopClick" />
                <MenuItem x:Name="OverviewMenuItem"
                          Header="完整概览"
                          InputGestureText="双击"
                          Style="{StaticResource PinMenuItem}"
                          Visibility="Collapsed"
                          Click="OnOverviewClick" />
                <MenuItem x:Name="ReaderModeMenuItem"
                          Header="长图阅读窗"
                          InputGestureText="双击"
                          Style="{StaticResource PinMenuItem}"
                          Visibility="Collapsed"
                          Click="OnReaderModeClick" />
                <MenuItem x:Name="FitMenuItem"
                          Header="适应屏幕"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnFitClick" />
                <MenuItem x:Name="ActualSizeMenuItem"
                          Header="原始大小  1:1"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnActualSizeClick" />
                <Separator Style="{StaticResource PinMenuSeparator}" />
                <MenuItem x:Name="CollapseMenuItem"
                          Header="暂时收起"
                          InputGestureText="M"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnCollapseClick" />
                <Separator Style="{StaticResource PinMenuSeparator}" />
                <MenuItem x:Name="CloseMenuItem"
                          Header="关闭贴图"
                          InputGestureText="Esc"
                          Style="{StaticResource PinMenuItem}"
                          Click="OnCloseClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid x:Name="ExpandedPinContent"
                  ClipToBounds="True">
            <!-- Keep all ordinary-image coordinates together. The carrier HWND
                 stays on integer pixels; this surface can compensate its phase. -->
            <Grid x:Name="NormalPinSurface" UseLayoutRounding="False" SnapsToDevicePixels="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  SizeChanged="OnNormalPinSurfaceSizeChanged">
            <Grid.RenderTransform><TranslateTransform x:Name="NormalPinZoomOffset" /></Grid.RenderTransform>
            <Image x:Name="PinnedImage"
                   Stretch="Uniform"
                   UseLayoutRounding="False" SnapsToDevicePixels="False"
                   MouseLeftButtonDown="OnImageMouseLeftButtonDown" />

            <Canvas x:Name="TextSelectionOverlay"
                    Visibility="Collapsed"
                    Background="Transparent"
                    Cursor="SizeAll"
                    ClipToBounds="True"
                    SizeChanged="OnTextOverlaySizeChanged"
                    MouseLeftButtonDown="OnTextOverlayMouseLeftButtonDown"
                    MouseMove="OnTextOverlayMouseMove"
                    MouseLeftButtonUp="OnTextOverlayMouseLeftButtonUp"
                    MouseLeave="OnTextOverlayMouseLeave" />

            <icons:QrCodeHotspotLayer x:Name="QrCodeHotspotLayer"
                                      Panel.ZIndex="30" />
            <Viewbox x:Name="PinAnnotationHost" Stretch="Uniform"
                     IsHitTestVisible="False" Panel.ZIndex="35" />
            </Grid>

            <ScrollViewer x:Name="LongImageScroller"
                          Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          PanningMode="Both"
                          ScrollChanged="OnLongImageScrollChanged">
                <Grid x:Name="LongImageSurface"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Image x:Name="LongPinnedImage"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           MouseLeftButtonDown="OnImageMouseLeftButtonDown" />
                    <Canvas x:Name="LongTextSelectionOverlay"
                            Visibility="Collapsed"
                            Background="Transparent"
                            Cursor="SizeAll"
                            ClipToBounds="True"
                            SizeChanged="OnTextOverlaySizeChanged"
                            MouseLeftButtonDown="OnTextOverlayMouseLeftButtonDown"
                            MouseMove="OnTextOverlayMouseMove"
                            MouseLeftButtonUp="OnTextOverlayMouseLeftButtonUp"
                            MouseLeave="OnTextOverlayMouseLeave" />
                    <icons:QrCodeHotspotLayer x:Name="LongQrCodeHotspotLayer"
                                              Panel.ZIndex="30" />
                    <Viewbox x:Name="LongPinAnnotationHost" Stretch="Fill"
                             IsHitTestVisible="False" Panel.ZIndex="35" />
                </Grid>
            </ScrollViewer>

            <Grid x:Name="ScrollRail"
                  Width="4"
                  Margin="0,8,5,8"
                  HorizontalAlignment="Right"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  SizeChanged="OnScrollRailSizeChanged">
                <Border Background="{DynamicResource ThemeBorderBrush}" CornerRadius="2" />
                <Border x:Name="ScrollThumb"
                        Height="36"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ThemeAccentBrush}"
                        CornerRadius="2">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <Grid x:Name="PinCloseHotspot"
                  Width="44" Height="44"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Background="Transparent"
                  Visibility="Collapsed"
                  Panel.ZIndex="50"
                  MouseEnter="OnPinCloseHotspotMouseEnter"
                  MouseLeave="OnPinCloseHotspotMouseLeave">
                <Button x:Name="PinCloseButton"
                        Margin="0,6,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource PinCloseButtonStyle}"
                        Opacity="0"
                        ToolTip="关闭贴图"
                        AutomationProperties.Name="关闭贴图"
                        Click="OnPinCloseClick">
                    <icons:QingSnapIcon Kind="Close" Width="15" Height="15" />
                </Button>
            </Grid>

            <Border x:Name="FeedbackBadge"
                    Margin="0,0,0,12"
                    Padding="10,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ThemeOverlayPanelBrush}"
                    BorderBrush="{DynamicResource ThemeBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="Collapsed">
                <TextBlock x:Name="FeedbackText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextBrush}" />
            </Border>
            </Grid>

            <Border x:Name="CollapsedDock"
                    Background="{DynamicResource ThemePanelBrush}"
                    BorderBrush="{DynamicResource ThemeAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    ToolTip="单击恢复，拖动可移动"
                    AutomationProperties.Name="恢复贴图"
                    MouseEnter="OnCollapsedDockMouseEnter"
                    MouseLeave="OnCollapsedDockMouseLeave"
                    MouseLeftButtonDown="OnCollapsedDockMouseLeftButtonDown"
                    MouseMove="OnCollapsedDockMouseMove"
                    MouseLeftButtonUp="OnCollapsedDockMouseLeftButtonUp">
                <Grid ClipToBounds="True">
                    <Image x:Name="CollapsedThumbnail"
                           Stretch="UniformToFill"
                           Opacity="1"
                           IsHitTestVisible="False" />
                    <Border x:Name="CollapsedPinBadge"
                            Width="16"
                            Height="16"
                            Margin="0,2,2,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#FFF04452"
                            BorderBrush="#FFFF8A94"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsHitTestVisible="False">
                        <icons:QingSnapIcon Kind="Pin"
                                            Width="9"
                                            Height="9"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="#FFFFFFFF" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
