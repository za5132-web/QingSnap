<Window x:Class="QingSnap.App.Views.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QingSnap OCR 文字识别"
        Icon="/Assets/QingSnap.ico"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ThemeWindowBrush}"
        Foreground="{DynamicResource ThemeTextBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Template" Value="{DynamicResource ThemePrimaryButtonTemplate}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ThemeChromeBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="5" Height="24" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource UiFont}" FontSize="16" FontWeight="SemiBold" Text="OCR 文字识别" />
                        <TextBlock x:Name="TitleStatusText"
                                   Margin="0,2,0,0"
                                   FontFamily="{StaticResource DataFont}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource ThemeMutedTextBrush}"
                                   Text="本地识别 · 正在准备" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButton}" Content="—" Click="OnMinimizeClick" />
                        <Button Style="{StaticResource WindowButton}" Content="□" Click="OnMaximizeClick" />
                        <Button Style="{StaticResource WindowButton}" Content="×" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,18,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource ThemeImageBackdropBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Image x:Name="SourceImage" Margin="8" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,13,2,0">
                            <TextBlock x:Name="SourceNameText"
                                       FontFamily="{StaticResource DataFont}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource ThemeTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SourceSizeText"
                                       Margin="0,6,0,0"
                                       FontFamily="{StaticResource DataFont}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}" />
                            <TextBlock Margin="0,9,0,0"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       Text="图片仅在本机处理，不会上传。" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource DataFont}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       Text="TEXT" />
                            <TextBlock x:Name="EditorStatsText"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource DataFont}"
                                       FontSize="10"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                       Text="等待识别" />
                        </Grid>
                        <Border Grid.Row="1" Margin="12,0" Background="{DynamicResource ThemeFieldBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5">
                            <TextBox x:Name="OcrTextBox"
                                     Margin="1"
                                     Padding="14,12"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     SpellCheck.IsEnabled="False"
                                     FontFamily="Microsoft YaHei UI"
                                     FontSize="14"
                                     TextBlock.LineHeight="23"
                                     Foreground="{DynamicResource ThemeTextBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource ThemeAccentBrush}"
                                     TextChanged="OnOcrTextChanged" />
                        </Border>
                        <TextBlock Grid.Row="2"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource ThemeSubtleTextBrush}"
                                   Text="识别结果可直接修改；Ctrl+A 全选，Ctrl+C 复制选中内容。" />

                        <Border x:Name="LoadingPanel" Grid.RowSpan="3" Background="{DynamicResource ThemeLoadingScrimBrush}" CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="180" Height="3" IsIndeterminate="True" Foreground="{DynamicResource ThemeAccentBrush}" />
                                <TextBlock Margin="0,14,0,0"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeTextBrush}"
                                           Text="正在识别文字…" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource ThemeChromeBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatusText"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               Foreground="{DynamicResource ThemeMutedTextBrush}"
                               Text="准备识别" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionButton}" Content="重新识别" Click="OnRetryClick" />
                        <Button x:Name="CopyAllButton" Style="{StaticResource PrimaryButton}" Margin="0" Content="复制全文" IsEnabled="False" Click="OnCopyAllClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
