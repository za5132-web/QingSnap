<Window x:Class="QingSnap.App.Views.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:QingSnap.App.Controls"
        Title="QingSnap 反馈"
        Icon="pack://application:,,,/QingSnap;component/Assets/QingSnap.ico"
        Width="620"
        Height="640"
        MinWidth="560"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF091017"
        Foreground="#FFF3F7F9"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="FeedbackPanel" Color="#FF101B23" />
        <SolidColorBrush x:Key="FeedbackField" Color="#FF09131A" />
        <SolidColorBrush x:Key="FeedbackLine" Color="#4D59707C" />
        <SolidColorBrush x:Key="FeedbackAccent" Color="#FF76DFEE" />
        <SolidColorBrush x:Key="FeedbackMuted" Color="#FF8FA2AD" />

        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /></Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFF3F7F9" />
            <Setter Property="CaretBrush" Value="{StaticResource FeedbackAccent}" />
            <Setter Property="Background" Value="{StaticResource FeedbackField}" />
            <Setter Property="BorderBrush" Value="#FF385966" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="FeedbackButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Foreground" Value="#FFDDE8EC" />
            <Setter Property="Background" Value="#FF172630" />
            <Setter Property="BorderBrush" Value="#FF365563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#FF223641" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF304F5C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF0C151D" BorderBrush="{StaticResource FeedbackLine}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <StackPanel Margin="16,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Background="#FF132A35" CornerRadius="7">
                            <icons:QingSnapIcon Kind="Text" Width="16" Height="16" Foreground="{StaticResource FeedbackAccent}" />
                        </Border>
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="问题反馈" />
                    </StackPanel>
                    <Button Width="44" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#FF91A6B0" Cursor="Hand" Click="OnCloseClick">
                        <icons:QingSnapIcon Kind="Close" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="20,12" Background="#FF0D171F" BorderBrush="{StaticResource FeedbackLine}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource FeedbackAccent}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="把问题描述和诊断信息放进同一个反馈包" />
                        <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource FeedbackMuted}" TextWrapping="Wrap" Text="无需部署服务器：生成后会打开 GitHub 反馈页，请把 ZIP 拖入页面。若要真正一键上传，后续仍需要部署接收接口。" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,12,20,10">
                    <TextBlock Margin="0,0,0,6" FontSize="11" Foreground="{StaticResource FeedbackMuted}" Text="反馈标题" />
                    <TextBox x:Name="FeedbackTitleBox" Height="36" MaxLength="120" />

                    <TextBlock Margin="0,12,0,6" FontSize="11" Foreground="{StaticResource FeedbackMuted}" Text="问题描述与复现步骤" />
                    <TextBox x:Name="FeedbackBodyBox"
                             Height="130"
                             MaxLength="8000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Margin="0,12,0,6" FontSize="11" Foreground="{StaticResource FeedbackMuted}" Text="联系方式（选填）" />
                    <TextBox x:Name="ContactBox" Height="36" MaxLength="200" />

                    <Border Margin="0,12,0,0" Padding="12,9" Background="{StaticResource FeedbackPanel}" BorderBrush="{StaticResource FeedbackLine}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <CheckBox x:Name="IncludeLogsCheck" IsChecked="True" Foreground="#FFE3EDF0" Content="附带最近 7 天的 QingSnap 运行日志" />
                            <TextBlock Margin="22,5,0,0" FontSize="10" Foreground="#FF718792" TextWrapping="Wrap" Text="反馈包始终包含版本和系统环境；不会包含截图记录、剪贴板内容或你的图片。提交前可以直接打开 ZIP 检查。" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" Margin="0,11,0,0" FontSize="10.5" Foreground="{StaticResource FeedbackMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#FF0D171F" BorderBrush="{StaticResource FeedbackLine}" BorderThickness="0,1,0,0">
                <StackPanel Margin="0,0,18,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource FeedbackButton}" Content="取消" Click="OnCloseClick" />
                    <Button Style="{StaticResource FeedbackButton}" Background="{StaticResource FeedbackAccent}" BorderBrush="{StaticResource FeedbackAccent}" Foreground="#FF08202A" Content="生成并前往反馈" Click="OnPrepareFeedbackClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
