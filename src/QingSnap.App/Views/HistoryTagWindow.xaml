<Window x:Class="QingSnap.App.Views.HistoryTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理标签"
        Width="460"
        Height="390"
        MinWidth="420"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        Foreground="{DynamicResource ThemeTextBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="TagActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagCloseButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <TextBlock FontFamily="{StaticResource UiFont}"
                                           FontSize="12"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{Binding}" />
                                <TextBlock x:Name="SelectedMark"
                                           HorizontalAlignment="Right"
                                           FontFamily="{StaticResource DataFont}"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           Text="✓"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSelectedBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemePopupBrush}"
            BorderBrush="{DynamicResource ThemeBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource ThemeChromeBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock x:Name="WindowTitleText"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="添加标签" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource TagCloseButton}"
                            Content="×"
                            Click="OnCancelClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="IntroText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="CustomTagsBox"
                         Grid.Row="1"
                         Height="38"
                         Margin="0,12,0,0"
                         Padding="11,7"
                         VerticalContentAlignment="Center"
                         FontFamily="{StaticResource UiFont}"
                         FontSize="13"
                         Foreground="{DynamicResource ThemeTextBrush}"
                         Background="{DynamicResource ThemeFieldBrush}"
                         BorderBrush="{DynamicResource ThemeBorderStrongBrush}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource ThemeAccentBrush}" />
                <TextBlock x:Name="ListLabelText"
                           Grid.Row="2"
                           Margin="0,14,0,7"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="11"
                           Foreground="{DynamicResource ThemeSubtleTextBrush}"
                           Text="已有标签 · 可多选" />
                <Grid Grid.Row="3">
                    <ListBox x:Name="TagList"
                             SelectionMode="Multiple"
                             ItemContainerStyle="{StaticResource TagListItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="EmptyTagsText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="12"
                               Foreground="{DynamicResource ThemeSubtleTextBrush}"
                               Text="还没有可选择的标签"
                               Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="ValidationText"
                           Grid.Row="4"
                           Margin="0,7,0,0"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="11"
                           Foreground="{DynamicResource ThemeWarningBrush}"
                           Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="2"
                    Padding="14,0"
                    Background="{DynamicResource ThemeChromeBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9">
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource TagActionButton}" Content="取消" Click="OnCancelClick" />
                    <Button x:Name="ApplyButton"
                            Style="{StaticResource TagActionButton}"
                            Foreground="{DynamicResource ThemeOnAccentBrush}"
                            Template="{DynamicResource ThemePrimaryButtonTemplate}"
                            Background="{DynamicResource ThemeAccentBrush}"
                            BorderBrush="{DynamicResource ThemeAccentBrush}"
                            Content="添加"
                            Click="OnApplyClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
