<Window x:Class="QingSnap.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:QingSnap.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QingSnap 设置"
        Width="780" Height="740"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF091017"
        Foreground="#FFF3F7F9"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="OnWindowStateChanged"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowSurface" Color="#FF091017" />
        <SolidColorBrush x:Key="TitleSurface" Color="#FF0C151D" />
        <SolidColorBrush x:Key="Panel" Color="#FF101B23" />
        <SolidColorBrush x:Key="FieldSurface" Color="#FF0A141B" />
        <SolidColorBrush x:Key="FieldHover" Color="#FF0E1B24" />
        <SolidColorBrush x:Key="Line" Color="#3D59707C" />
        <SolidColorBrush x:Key="Accent" Color="#FF76DFEE" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF3F7F9" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF8FA2AD" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource FieldSurface}" />
            <Setter Property="BorderBrush" Value="#80536A76" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="#8076DFEE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource FieldHover}" />
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#B36C8794" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF1C303B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF17303A" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource FieldSurface}" />
            <Setter Property="BorderBrush" Value="#80536A76" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Grid.Column="1"
                                          Width="9" Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M1,1 L4.5,4.5 L8,1"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                        Margin="0,4,0,0"
                                        Padding="2"
                                        Background="#FF0D181F"
                                        BorderBrush="#B3536A76"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource FieldHover}" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#B36C8794" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFDCE7EC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckSurface"
                                    Width="16" Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource FieldSurface}"
                                    BorderBrush="#99536A76"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="CheckMark"
                                      Width="9" Height="7"
                                      Data="M1,3.5 L3.7,6 L8,1"
                                      Stroke="#FF071116"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Background="#B34C6673" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#FF76DFEE" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#FF9EEAF4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="0,5,2,5" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#FF1D2E39" />
            <Setter Property="BorderBrush" Value="#66536A76" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF29404C" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#9976DFEE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF16242D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#FF071116" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="#FF9EEAF4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF9EEAF4" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF59C9DA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="#FF9FB0B9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1B2B35" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF263A45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE05260" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,13" />
            <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="#FF182832" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowSurface}" BorderBrush="#80536A76" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleSurface}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Background="#FF132630" CornerRadius="7">
                            <icons:QingSnapIcon Kind="Capture" Width="18" Height="18" Foreground="{StaticResource Accent}" />
                        </Border>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="QingSnap 设置" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButton}" ToolTip="最小化" AutomationProperties.Name="最小化" Click="OnMinimizeClick">
                            <icons:QingSnapIcon Kind="Minimize" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="最大化" AutomationProperties.Name="最大化" Click="OnMaximizeClick">
                            <icons:QingSnapIcon x:Name="MaximizeIcon" Kind="Maximize" Width="15" Height="15" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButton}" ToolTip="关闭" AutomationProperties.Name="关闭" Click="OnCloseWindowClick">
                            <icons:QingSnapIcon Kind="Close" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#FF0D171F" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="5" Height="38" Background="{StaticResource Accent}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="设置" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource TextMuted}" Text="快捷键、截图行为和输出参数会立即应用" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Padding="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly">
                <StackPanel Margin="28,20,20,24">
                    <Border Padding="18" Margin="0,0,0,14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="SHORTCUTS  /  快捷键" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="区域截图"/><TextBox x:Name="CaptureHotkeyBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="贴图"/><TextBox x:Name="PinHotkeyBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="重复上次范围"/><TextBox x:Name="RepeatHotkeyBox"/></StackPanel>
                            </Grid>
                            <TextBlock Margin="0,9,0,0" FontSize="10" Foreground="#FF71848F" Text="支持 Ctrl / Shift / Alt + F1–F12，例如 Ctrl+Shift+F2。三个快捷键不能重复。" />
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="OCR  /  文字识别" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="识别引擎" />
                                    <ComboBox x:Name="OcrEngineCombo" SelectionChanged="OnOcrEngineChanged">
                                        <ComboBoxItem Content="高精度 · PP-OCRv6" Tag="Advanced" />
                                        <ComboBoxItem Content="Windows OCR" Tag="Windows" />
                                    </ComboBox>
                                    <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="性能策略" />
                                    <ComboBox x:Name="OcrPerformanceCombo" SelectionChanged="OnOcrEngineChanged">
                                        <ComboBoxItem Content="极速 · 后台预热" Tag="Instant" />
                                        <ComboBoxItem Content="节能 · 闲置释放" Tag="Balanced" />
                                    </ComboBox>
                                </StackPanel>
                                <Border Grid.Column="2" Padding="14,11" Background="#FF0B171E" BorderBrush="#48536A76" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="OcrStatusRail" Background="{StaticResource Accent}" CornerRadius="2" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock x:Name="OcrModelStatusText" FontSize="12" FontWeight="SemiBold" Text="正在检查模型…" />
                                            <TextBlock x:Name="OcrEngineDescriptionText" Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ProgressBar x:Name="OcrDownloadProgress" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Style="{StaticResource SlimProgress}" />
                            <Grid Margin="0,12,0,0">
                                <TextBlock x:Name="OcrDownloadStatusText" VerticalAlignment="Center" FontSize="10.5" Foreground="#FF71848F" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button x:Name="OcrDeleteButton" Style="{StaticResource ActionButton}" Content="删除模型" Click="OnOcrDeleteClick" />
                                    <Button x:Name="OcrInstallButton" Style="{StaticResource ActionButton}" Content="立即下载" Click="OnOcrInstallClick" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="CAPTURE  /  截图" />
                            <WrapPanel>
                                <CheckBox x:Name="SmartSelectionCheck" Width="218" Content="自动识别窗口和控件" />
                                <CheckBox x:Name="MagnifierCheck" Width="218" Content="显示像素放大镜与颜色" />
                                <CheckBox x:Name="AutoCopyCheck" Width="190" Content="截图后自动复制" />
                            </WrapPanel>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="218" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="关闭按钮" />
                                    <ComboBox x:Name="CloseInteractionCombo">
                                        <ComboBoxItem Content="仅使用 Esc" Tag="Escape" />
                                        <ComboBoxItem Content="Esc + X 按钮" Tag="Button" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Margin="0,20,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap"
                                           Text="Esc 始终可以关闭；启用 X 后，截图工具栏会常驻关闭按钮，贴图右上角的关闭按钮会自动渐隐。" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="0.7*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="截图延时"/><ComboBox x:Name="DelayCombo"><ComboBoxItem Content="立即" Tag="0"/><ComboBoxItem Content="1 秒" Tag="1"/><ComboBoxItem Content="3 秒" Tag="3"/><ComboBoxItem Content="5 秒" Tag="5"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="默认标注颜色"/><TextBox x:Name="AnnotationColorBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="线条粗细"/><TextBox x:Name="AnnotationThicknessBox"/></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource FieldLabel}" Text="文字大小"/><TextBox x:Name="AnnotationFontSizeBox"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="OUTPUT  /  保存与记录" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="图片格式"/><ComboBox x:Name="FormatCombo"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPG"/><ComboBoxItem Content="BMP"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="JPG 质量"/><TextBox x:Name="JpegQualityBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="自动清理（天，0 为永久）"/><TextBox x:Name="RetentionBox"/></StackPanel>
                            </Grid>
                            <TextBlock Margin="0,13,0,6" Style="{StaticResource FieldLabel}" Text="截图记录目录"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="HistoryDirectoryBox" />
                                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="选择目录" Click="OnBrowseHistoryClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="LONG CAPTURE  /  长截图" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="滚动步长（120–1200）"/><TextBox x:Name="LongWheelBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="失败重试次数（1–6）"/><TextBox x:Name="LongRetryBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="最小重叠（12%–50%）"/><TextBox x:Name="LongOverlapBox"/></StackPanel>
                            </Grid>
                            <CheckBox x:Name="StartupCheck" Margin="0,16,0,0" Content="登录 Windows 后自动启动 QingSnap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#FF0D171F" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="28,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Text="修改后点击保存"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButton}" Content="取消" Click="OnCancelClick"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="保存设置" Click="OnSaveClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
