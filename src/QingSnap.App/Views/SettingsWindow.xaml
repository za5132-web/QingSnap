<Window x:Class="QingSnap.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:QingSnap.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QingSnap 设置"
        Icon="/Assets/QingSnap.ico"
        Width="780" Height="740"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeWindowBrush}"
        Foreground="{DynamicResource ThemeTextBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="OnWindowStateChanged"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelectionBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Grid.Column="1"
                                          Width="9" Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M1,1 L4.5,4.5 L8,1"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                        Margin="0,4,0,0"
                                        Padding="2"
                                        Background="{DynamicResource ThemePopupBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckSurface"
                                    Width="16" Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ThemeFieldBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="CheckMark"
                                      Width="9" Height="7"
                                      Data="M1,3.5 L3.7,6 L8,1"
                                      Stroke="{DynamicResource ThemeOnAccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Background="{DynamicResource ThemeScrollbarBrush}" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="0,5,2,5" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Template" Value="{DynamicResource ThemePrimaryButtonTemplate}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDangerBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,13" />
            <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>

        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBrush}" BorderBrush="{DynamicResource ThemeBorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ThemeChromeBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Background="{DynamicResource ThemeHoverBrush}" CornerRadius="7">
                            <icons:QingSnapIcon Kind="Capture" Width="18" Height="18" Foreground="{DynamicResource ThemeAccentBrush}" />
                        </Border>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="QingSnap 设置" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButton}" ToolTip="最小化" AutomationProperties.Name="最小化" Click="OnMinimizeClick">
                            <icons:QingSnapIcon Kind="Minimize" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="最大化" AutomationProperties.Name="最大化" Click="OnMaximizeClick">
                            <icons:QingSnapIcon x:Name="MaximizeIcon" Kind="Maximize" Width="15" Height="15" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButton}" ToolTip="关闭" AutomationProperties.Name="关闭" Click="OnCloseWindowClick">
                            <icons:QingSnapIcon Kind="Close" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource ThemePopupBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="5" Height="38" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="设置" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" Text="快捷键、截图行为和输出参数会立即应用" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Padding="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly">
                <StackPanel Margin="28,20,20,24">
                    <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="APPEARANCE  /  界面主题" />
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource ThemeMutedTextBrush}" Text="保存后应用，不改变图片和标注颜色。" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBoxItem Content="深色" Tag="Dark" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="跟随系统" Tag="System" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="SHORTCUTS  /  快捷键" />
                            <Border Margin="0,1,0,0" Padding="10,7" Background="{DynamicResource ThemePanelBrush}" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="176" />
                                        <ColumnDefinition Width="196" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="9.5" Foreground="{DynamicResource ThemeSubtleTextBrush}" Text="启用" />
                                    <TextBlock Grid.Column="1" FontSize="9.5" Foreground="{DynamicResource ThemeSubtleTextBrush}" Text="功能" />
                                    <TextBlock Grid.Column="2" FontSize="9.5" Foreground="{DynamicResource ThemeSubtleTextBrush}" Text="全局快捷键" />
                                    <TextBlock Grid.Column="3" FontSize="9.5" Foreground="{DynamicResource ThemeSubtleTextBrush}" Text="说明" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding HotkeyRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid MinHeight="43" Margin="10,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="176" />
                                                    <ColumnDefinition Width="196" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="HotkeyEnabledCheck"
                                                          Margin="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          ToolTip="启用这个全局快捷键" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThemeTextBrush}"
                                                           Text="{Binding DisplayName}" />
                                                <TextBox Grid.Column="2"
                                                         Width="178"
                                                         Height="30"
                                                         Margin="0"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Padding="9,3"
                                                         Cursor="Hand"
                                                         IsReadOnly="True"
                                                         TextAlignment="Center"
                                                         Tag="{Binding}"
                                                         ToolTip="点击后直接按下快捷键；Backspace 或 Delete 清空"
                                                         GotKeyboardFocus="OnHotkeyBoxGotKeyboardFocus"
                                                         LostKeyboardFocus="OnHotkeyBoxLostKeyboardFocus"
                                                         PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"
                                                         PreviewTextInput="OnHotkeyBoxPreviewTextInput"
                                                         Text="{Binding Gesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="3"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource ThemeSubtleTextBrush}"
                                                           Text="{Binding Description}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Description}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,9,0,0" FontSize="10" Foreground="{DynamicResource ThemeSubtleTextBrush}" Text="点击快捷键框后直接按组合键；Backspace / Delete 清空。支持 F1–F12 与 Ctrl / Shift / Alt，启用项不能重复。" />
                            <TextBlock x:Name="HotkeyRegistrationStatusText"
                                       Margin="0,7,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource ThemeDangerBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="OCR  /  文字识别" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="OCR 模型" />
                                    <ComboBox x:Name="OcrModelCombo" SelectionChanged="OnOcrEngineChanged">
                                        <ComboBoxItem Content="不安装 OCR" Tag="None" />
                                        <ComboBoxItem Content="极速 · PP-OCRv6 Tiny" Tag="Tiny" />
                                        <ComboBoxItem Content="高精度 · PP-OCRv6 Small" Tag="Small" />
                                    </ComboBox>
                                    <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="性能策略" />
                                    <ComboBox x:Name="OcrPerformanceCombo" SelectionChanged="OnOcrEngineChanged">
                                        <ComboBoxItem Content="极速 · 后台预热" Tag="Instant" />
                                        <ComboBoxItem Content="节能 · 闲置释放" Tag="Balanced" />
                                    </ComboBox>
                                </StackPanel>
                                <Border Grid.Column="2" Padding="14,11" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="OcrStatusRail" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="2" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock x:Name="OcrModelStatusText" FontSize="12" FontWeight="SemiBold" Text="正在检查模型…" />
                                            <TextBlock x:Name="OcrEngineDescriptionText" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource ThemeMutedTextBrush}" TextWrapping="Wrap" />
                                            <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                                <TextBlock x:Name="OcrRuntimeStageText" FontSize="10" FontWeight="SemiBold" Text="○ 运行库" />
                                                <TextBlock Margin="8,0" FontSize="10" Foreground="{DynamicResource ThemeBorderStrongBrush}" Text="→" />
                                                <TextBlock x:Name="OcrModelStageText" FontSize="10" FontWeight="SemiBold" Text="○ 模型" />
                                                <TextBlock Margin="8,0" FontSize="10" Foreground="{DynamicResource ThemeBorderStrongBrush}" Text="→" />
                                                <TextBlock x:Name="OcrReadyStageText" FontSize="10" FontWeight="SemiBold" Text="○ 可用" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ProgressBar x:Name="OcrDownloadProgress" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Style="{StaticResource SlimProgress}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OcrDownloadStatusText" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource ThemeSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="OcrDeleteButton" Style="{StaticResource ActionButton}" Content="卸载 OCR" Click="OnOcrDeleteClick" />
                                    <Button x:Name="OcrRuntimeButton" Style="{StaticResource ActionButton}" Content="安装运行库" Click="OnOcrRuntimeInstallClick" />
                                    <Button x:Name="OcrInstallButton" Style="{StaticResource ActionButton}" Content="安装模型" Click="OnOcrInstallClick" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="CAPTURE  /  截图" />
                            <WrapPanel>
                                <CheckBox x:Name="MagnifierCheck" Width="218" Content="显示像素放大镜与颜色" />
                                <CheckBox x:Name="AutoCopyCheck" Width="190" Content="截图后自动复制" />
                                <CheckBox x:Name="QuickCaptureTagsCheck" Width="218" Content="截图时快速添加标签" />
                            </WrapPanel>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="218" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="关闭按钮" />
                                    <ComboBox x:Name="CloseInteractionCombo">
                                        <ComboBoxItem Content="仅使用 Esc" Tag="Escape" />
                                        <ComboBoxItem Content="Esc + X 按钮" Tag="Button" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Margin="0,20,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Esc 始终可以关闭；启用 X 后，截图工具栏会常驻关闭按钮，贴图右上角的关闭按钮会自动渐隐。" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="0.7*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="截图延时"/><ComboBox x:Name="DelayCombo"><ComboBoxItem Content="立即" Tag="0"/><ComboBoxItem Content="1 秒" Tag="1"/><ComboBoxItem Content="3 秒" Tag="3"/><ComboBoxItem Content="5 秒" Tag="5"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="默认标注颜色"/><TextBox x:Name="AnnotationColorBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="线条粗细"/><TextBox x:Name="AnnotationThicknessBox"/></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource FieldLabel}" Text="文字大小"/><TextBox x:Name="AnnotationFontSizeBox"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="OUTPUT  /  保存与记录" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="图片格式"/><ComboBox x:Name="FormatCombo"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPG"/><ComboBoxItem Content="BMP"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="JPG 质量"/><TextBox x:Name="JpegQualityBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="自动清理（天，0 为永久）"/><TextBox x:Name="RetentionBox"/></StackPanel>
                            </Grid>
                            <TextBlock Margin="0,13,0,6" Style="{StaticResource FieldLabel}" Text="截图记录目录"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="HistoryDirectoryBox" />
                                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="选择目录" Click="OnBrowseHistoryClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="LONG CAPTURE  /  长截图" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="滚动步长（120–1200）"/><TextBox x:Name="LongWheelBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="失败重试次数（1–6）"/><TextBox x:Name="LongRetryBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="最小重叠（12%–50%）"/><TextBox x:Name="LongOverlapBox"/></StackPanel>
                            </Grid>
                            <CheckBox x:Name="StartupCheck" Margin="0,16,0,0" Content="登录 Windows 后自动启动 QingSnap" />
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="ABOUT / UPDATE  /  关于与更新" />
                                <CheckBox x:Name="AutoUpdateCheck"
                                          Grid.Column="1"
                                          Margin="18,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="启动后自动检查更新" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="当前版本" />
                                    <TextBlock x:Name="CurrentVersionText" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" Text="—" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="最新版本" />
                                    <TextBlock x:Name="LatestVersionText" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" Text="尚未检查" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="发布日期" />
                                    <TextBlock x:Name="UpdatePublishedText" Margin="0,3,0,0" Foreground="{DynamicResource ThemeTextBrush}" Text="—" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="文件大小" />
                                    <TextBlock x:Name="UpdateFileSizeText" Margin="0,3,0,0" Foreground="{DynamicResource ThemeTextBrush}" Text="—" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="14,12"
                                    Background="{DynamicResource ThemePanelBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="UpdateStatusRail" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="2" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="UpdateStatusText" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" Text="尚未检查更新" />
                                        <ScrollViewer Margin="0,7,0,0" MaxHeight="92" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="UpdateNotesText"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                       LineHeight="18"
                                                       Text="点击“检查更新”获取 GitHub Releases 中的最新版本。"
                                                       TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ProgressBar x:Name="UpdateDownloadProgress"
                                         Margin="0,12,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Visibility="Collapsed"
                                         Style="{StaticResource SlimProgress}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateDownloadStatusText"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="UpdateOpenFolderButton"
                                            Visibility="Collapsed"
                                            Style="{StaticResource ActionButton}"
                                            Content="打开文件位置"
                                            Click="OnOpenUpdateFolderClick" />
                                    <Button x:Name="UpdateDownloadButton"
                                            Visibility="Collapsed"
                                            Style="{StaticResource ActionButton}"
                                            Content="下载更新"
                                            Click="OnDownloadUpdateClick" />
                                    <Button x:Name="UpdateCheckButton"
                                            Margin="0"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="检查更新"
                                            Click="OnCheckUpdatesClick" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Margin="0,0,0,14" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="GUIDE  /  使用教程" />
                                <TextBlock Margin="0,1,18,0"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                                           Text="重新查看截图、长截图、贴图、文字选取与截图记录的交互演示。" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ActionButton}"
                                    Content="重新播放教程"
                                    Click="OnReplayTutorialClick" />
                        </Grid>
                    </Border>

                    <Border Padding="18" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="FEEDBACK  /  问题反馈" />
                                <TextBlock Margin="0,1,18,0"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                                           Text="描述问题并生成包含可选日志的反馈包，然后前往反馈页面提交。" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ActionButton}"
                                    Content="发送反馈"
                                    Click="OnOpenFeedbackClick" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource ThemePopupBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="28,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedTextBrush}" Text="修改后点击保存"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButton}" Content="取消" Click="OnCancelClick"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="保存设置" Click="OnSaveClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
