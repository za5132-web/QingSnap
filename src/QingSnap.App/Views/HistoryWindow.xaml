<Window x:Class="QingSnap.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:QingSnap.App.Controls"
        Title="QingSnap 截图记录"
        Icon="/Assets/QingSnap.ico"
        Width="980"
        Height="720"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF0B1118"
        Foreground="#FFF3F7F9"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF111A22" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#FF17222C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF76DFEE" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF8D9AA5" />
        <SolidColorBrush x:Key="FieldBrush" Color="#FF0D151C" />
        <SolidColorBrush x:Key="FieldHoverBrush" Color="#FF12212A" />

        <Style x:Key="HistoryContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="5"
                                Background="#FF0D171F"
                                BorderBrush="#FF344957"
                                BorderThickness="1"
                                CornerRadius="7">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Width" Value="176" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#FFDDE8ED" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Header}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#FF19303A" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF3F7F9" />
            <Setter Property="Background" Value="#FF22313D" />
            <Setter Property="BorderBrush" Value="#3DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF2B3E4C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9976DFEE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#FFFFD9D3" />
            <Setter Property="Background" Value="#FF40272A" />
            <Setter Property="BorderBrush" Value="#668F4A4E" />
        </Style>

        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#FFBFF7FF" />
            <Setter Property="Background" Value="#FF17343C" />
            <Setter Property="BorderBrush" Value="#6676DFEE" />
        </Style>

        <Style x:Key="OcrButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#FFFFE6B0" />
            <Setter Property="Background" Value="#FF3A3020" />
            <Setter Property="BorderBrush" Value="#668F7442" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="#FFB8C3CA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF25313B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewModeButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#FF8FA0AA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ModeChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeChrome" Property="Background" Value="#FF1B2A34" />
                                <Setter Property="Foreground" Value="#FFF3F7F9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeChrome" Property="Background" Value="#FF19333D" />
                                <Setter TargetName="ModeChrome" Property="BorderBrush" Value="#8876DFEE" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFDCE7EC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF1C303B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF17303A" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFDCE7EC" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="#FF2A3945" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Grid.Column="1"
                                          Width="9" Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M1,1 L4.5,4.5 L8,1"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                        Margin="0,4,0,0"
                                        Padding="2"
                                        Background="#FF0D181F"
                                        BorderBrush="#B3536A76"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#B36C8794" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#334A5C69" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FF0E171F"
                    BorderBrush="#223D5362"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="5" Height="24" Background="{StaticResource AccentBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource UiFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="截图记录" />
                        <TextBlock x:Name="HeaderStatsText"
                                   Margin="0,2,0,0"
                                   FontFamily="{StaticResource DataFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="正在读取…" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="ListViewButton" Style="{StaticResource ViewModeButton}"
                                      IsChecked="True" ToolTip="列表模式" AutomationProperties.Name="列表模式" Click="OnListViewClick">
                            <controls:QingSnapIcon Kind="ListView" Width="18" Height="18" />
                        </ToggleButton>
                        <ToggleButton x:Name="GridViewButton" Style="{StaticResource ViewModeButton}"
                                      ToolTip="图标模式" AutomationProperties.Name="图标模式" Click="OnGridViewClick">
                            <controls:QingSnapIcon Kind="GridView" Width="17" Height="17" />
                        </ToggleButton>
                        <Border Width="1" Height="22" Margin="8,0,4,0" Background="#334A5C69" />
                        <Button Style="{StaticResource WindowButton}" Content="—" Click="OnMinimizeClick" />
                        <Button Style="{StaticResource WindowButton}" Content="□" Click="OnMaximizeClick" />
                        <Button Style="{StaticResource WindowButton}" Content="×" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="20,18,20,14" Padding="14" Background="{StaticResource PanelBrush}" CornerRadius="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,12,0">
                        <TextBox x:Name="SearchBox"
                                 Height="38"
                                 Padding="12,8"
                                 VerticalContentAlignment="Center"
                                 FontFamily="{StaticResource UiFont}"
                                 FontSize="13"
                                 Foreground="#FFF3F7F9"
                                 Background="#FF0D151C"
                                 BorderBrush="#FF2A3945"
                                 BorderThickness="1"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 TextChanged="OnSearchTextChanged" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="13"
                                   Foreground="#FF687783"
                                   Text="搜索文件名、文字、来源或标签" />
                    </Grid>
                    <ComboBox x:Name="TagFilter"
                              Grid.Column="1"
                              Height="38"
                              Margin="0,0,12,0"
                              VerticalContentAlignment="Center"
                              FontFamily="{StaticResource UiFont}"
                              SelectedIndex="0"
                              SelectionChanged="OnTagFilterChanged">
                        <ComboBoxItem Content="全部标签" Tag="" />
                    </ComboBox>
                    <ComboBox x:Name="DateFilter"
                              Grid.Column="2"
                              Height="38"
                              Margin="0,0,12,0"
                              VerticalContentAlignment="Center"
                              FontFamily="{StaticResource UiFont}"
                              SelectedIndex="0"
                              SelectionChanged="OnDateFilterChanged">
                        <ComboBoxItem Content="全部日期" />
                        <ComboBoxItem Content="今天" />
                        <ComboBoxItem Content="最近 7 天" />
                        <ComboBoxItem Content="长截图" />
                        <ComboBoxItem Content="已收藏" />
                    </ComboBox>
                    <Button Grid.Column="3"
                            Style="{StaticResource ActionButton}"
                            Content="刷新"
                            Click="OnRefreshClick" />
                    <Button Grid.Column="4"
                            Style="{StaticResource ActionButton}"
                            Margin="0"
                            Content="打开文件夹"
                            Click="OnOpenFolderClick" />
                </Grid>
            </Border>

            <Border x:Name="BatchActionPanel" Grid.Row="2" Margin="20,0,20,12" Padding="12,9"
                    Background="#FF10202A" BorderBrush="#6676DFEE" BorderThickness="1"
                    CornerRadius="8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BatchSelectionText" VerticalAlignment="Center"
                               FontFamily="{StaticResource DataFont}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Text="已选 0 张" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButton}" Content="收藏" Click="OnBatchFavoriteClick" />
                        <Button Style="{StaticResource ActionButton}" Content="取消收藏" Click="OnBatchUnfavoriteClick" />
                        <Button Style="{StaticResource ActionButton}" Content="添加标签" Click="OnBatchAddTagsClick" />
                        <Button Style="{StaticResource ActionButton}" Content="移除标签" Click="OnBatchRemoveTagsClick" />
                        <Button Style="{StaticResource ActionButton}" Content="复制路径" Click="OnBatchCopyPathsClick" />
                        <Button Style="{StaticResource DangerButton}" Margin="0" Content="删除" Click="OnBatchDeleteClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="20,0,20,0" MouseLeftButtonDown="OnHistoryAreaMouseLeftButtonDown">
                <ListBox x:Name="HistoryItemsControl"
                         ItemsSource="{Binding VisibleItems, Mode=OneWay}"
                         SelectionMode="Multiple"
                         SelectionChanged="OnHistoryListSelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.ScrollChanged="OnHistoryScrollChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                        Padding="18"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        PreviewMouseRightButtonDown="OnHistoryItemMouseRightButtonDown"
                                        MouseLeftButtonDown="OnHistoryItemMouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                            <Setter Property="BorderBrush" Value="#FF24333E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="#FF142630" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Height="180">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="330" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Margin="0,2,22,2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontFamily="{StaticResource DataFont}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFF3F7F9"
                                                       Text="{Binding DateText}" />
                                            <StackPanel Grid.Row="1" Margin="0,15,0,0">
                                                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                                    <Run Text="尺寸  " /><Run Text="{Binding DimensionsText, Mode=OneWay}" Foreground="#FFD5DEE3" />
                                                </TextBlock>
                                                <TextBlock Margin="0,7,0,0" FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                                    <Run Text="文件  " /><Run Text="{Binding FileSizeText, Mode=OneWay}" Foreground="#FFD5DEE3" />
                                                </TextBlock>
                                                <TextBlock Margin="0,7,0,0"
                                                           FontFamily="{StaticResource DataFont}"
                                                           FontSize="10.5"
                                                           Foreground="#FF687783"
                                                           Text="{Binding FileName, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,7,0,0"
                                                           FontFamily="{StaticResource UiFont}"
                                                           FontSize="10.5"
                                                           Foreground="#FF718591"
                                                           Text="{Binding SourceDisplay, Mode=OneWay}"
                                                           ToolTip="{Binding SourceWindowTitle, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSource, Mode=OneWay}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,7,0,0"
                                                           FontFamily="{StaticResource UiFont}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Text="{Binding TagsDisplay, Mode=OneWay}"
                                                           ToolTip="{Binding TagsDisplay, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTags, Mode=OneWay}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                                <Button Style="{StaticResource ActionButton}" Content="{Binding FavoriteText, Mode=OneWay}" Tag="{Binding Mode=OneWay}" Click="OnFavoriteItemClick" />
                                                <Button Style="{StaticResource PinButton}" Content="贴图" Tag="{Binding Mode=OneWay}" Click="OnPinItemClick" />
                                                <Button Style="{StaticResource OcrButton}" Content="识字" Tag="{Binding Mode=OneWay}" Click="OnOcrItemClick" />
                                                <Button Style="{StaticResource ActionButton}" Content="打开" Tag="{Binding Mode=OneWay}" Click="OnOpenItemClick" />
                                                <Button Style="{StaticResource ActionButton}" Content="复制" Tag="{Binding Mode=OneWay}" Click="OnCopyItemClick" />
                                                <Button Style="{StaticResource DangerButton}" Content="删除" Tag="{Binding Mode=OneWay}" Click="OnDeleteItemClick" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Column="1"
                                                Background="#FF080D12"
                                                BorderBrush="#FF2A3945"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="HistoryPreviewImage"
                                                       Stretch="Uniform" Margin="8"
                                                       Loaded="OnThumbnailLoaded"
                                                       Unloaded="OnThumbnailUnloaded"
                                                       DataContextChanged="OnThumbnailDataContextChanged" />
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,8,8"
                                                        Padding="7,3"
                                                        Background="#DD0C141B"
                                                        CornerRadius="4">
                                                    <TextBlock FontFamily="{StaticResource DataFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Text="{Binding DimensionsText, Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="HistoryGridControl"
                         Visibility="Collapsed"
                         ItemsSource="{Binding GridRows, Mode=OneWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.ScrollChanged="OnHistoryScrollChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="202" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="214" Height="194" Margin="4" Padding="9"
                                                BorderThickness="1" CornerRadius="8"
                                                PreviewMouseRightButtonDown="OnHistoryItemMouseRightButtonDown"
                                                MouseLeftButtonDown="OnHistoryItemMouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                                    <Setter Property="BorderBrush" Value="#FF24333E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#FF142630" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="124" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Background="#FF080D12" BorderBrush="#FF2A3945"
                                                        BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                                                    <Grid>
                                                        <Image x:Name="HistoryPreviewImage"
                                                               Stretch="Uniform" Margin="5"
                                                               Loaded="OnThumbnailLoaded"
                                                               Unloaded="OnThumbnailUnloaded"
                                                               DataContextChanged="OnThumbnailDataContextChanged" />
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="0,0,5,5" Padding="5,2"
                                                                Background="#E60C141B" CornerRadius="3">
                                                            <TextBlock FontFamily="{StaticResource DataFont}" FontSize="9"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       Text="{Binding Item.DimensionsText, Mode=OneWay}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Row="1" Margin="2,8,2,0"
                                                           FontFamily="{StaticResource DataFont}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#FFF3F7F9" Text="{Binding Item.DateText, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Grid Grid.Row="2" Margin="2,5,2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontFamily="{StaticResource UiFont}" FontSize="10"
                                                               Foreground="#FF718591" Text="{Binding Item.FileName, Mode=OneWay}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Margin="7,0,0,0"
                                                               FontFamily="{StaticResource UiFont}" FontSize="9.5"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Text="{Binding Item.TagsDisplay, Mode=OneWay}"
                                                               MaxWidth="70" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="48" Height="48" Background="#FF17232C" BorderBrush="#5576DFEE" BorderThickness="1" CornerRadius="24">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource DataFont}" FontSize="19" Foreground="{StaticResource AccentBrush}" Text="[ ]" />
                    </Border>
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="SemiBold" Text="没有匹配的截图" />
                    <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="按 F1 创建第一张截图，或调整筛选条件。" />
                </StackPanel>

                <Border x:Name="LoadingPanel" Background="#B30B1118">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="180" Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Margin="0,13,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource DataFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="正在建立缩略图索引…" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="#FF0E171F" BorderBrush="#223D5362" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           Margin="20,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DataFont}"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedBrush}"
                           Text="就绪" />
            </Border>
        </Grid>
    </Border>
</Window>
