<Window x:Class="QingSnap.App.Views.LongCaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QingSnap Long Capture Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas x:Name="Surface" IsHitTestVisible="False">
        <Rectangle x:Name="TopShade" Fill="#88090E14" />
        <Rectangle x:Name="BottomShade" Fill="#88090E14" />
        <Rectangle x:Name="LeftShade" Fill="#88090E14" />
        <Rectangle x:Name="RightShade" Fill="#88090E14" />

        <Rectangle x:Name="TopRail" Fill="#FF76DFEE" />
        <Rectangle x:Name="BottomRail" Fill="#FF76DFEE" />
        <Rectangle x:Name="LeftRail" Fill="#FF76DFEE" />
        <Rectangle x:Name="RightRail" Fill="#FF76DFEE" />

        <Border x:Name="StateBadge"
                Padding="11,7,12,7"
                Background="#F20E171F"
                BorderBrush="#6676DFEE"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Border Width="3"
                        Margin="0,1,9,1"
                        Background="#FF76DFEE"
                        CornerRadius="2" />
                <StackPanel>
                    <TextBlock x:Name="ModeText"
                               FontFamily="{StaticResource DataFont}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#FF76DFEE"
                               Text="LONG CAPTURE" />
                    <TextBlock x:Name="StateText"
                               Margin="0,2,0,0"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FFF3F7F9"
                               Text="选区保持显示 · Enter 停止 · Esc 取消" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
