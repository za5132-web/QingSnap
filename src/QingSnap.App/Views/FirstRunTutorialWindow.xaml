                                    <Border Width="265" Height="170" Background="#FFF8FAFB" BorderBrush="{StaticResource GuideAccent}" BorderThickness="1" CornerRadius="5"><StackPanel Margin="20"><Border Width="138" Height="10" HorizontalAlignment="Left" Background="#FF7E939D" CornerRadius="3"/><Border Height="7" Margin="0,13,0,0" Background="#FFD0DCE0" CornerRadius="3"/><Border Height="60" Margin="0,14,0,0" Background="#FFBFD7DD" CornerRadius="3"/></StackPanel></Border>
                                    <Border Margin="0,0,32,28" Padding="9,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#EE0A1720" CornerRadius="5"><TextBlock FontSize="10.5" Foreground="{StaticResource GuideAccent}" Text="已从历史重新贴出"/></Border>
                                </Grid>
                                <Grid x:Name="HistoryCaptureScene" Panel.ZIndex="30" Background="#FF61696E" Opacity="0">
                                    <Border Margin="28,22" Background="#FFF8FAFB" CornerRadius="5" />
                                    <Border Background="#70091017" />
                                    <Border x:Name="HistorySelectionA" Margin="84,57,105,72" BorderBrush="#5576DFEE" BorderThickness="1" Opacity="0" />
                                    <Border x:Name="HistorySelectionB" Margin="105,70,78,57" BorderBrush="#9976DFEE" BorderThickness="1.5" Opacity="0" />
                                    <Border x:Name="HistorySelectionC" Margin="70,48,92,65" Background="#FFF8FAFB" BorderBrush="{StaticResource GuideAccent}" BorderThickness="2" Opacity="0" />
                                    <Border x:Name="HistoryRKeycap" Margin="32,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource GuideDemoKeycap}" Opacity="0"><TextBlock FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GuideAccent}" Text="R"/></Border>
                                    <Border x:Name="HistoryRecaptureBadge" Margin="0,0,34,27" Padding="10,7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#EE0A1720" CornerRadius="5" Opacity="0"><StackPanel Orientation="Horizontal"><icons:QingSnapIcon Kind="Capture" Width="14" Height="14" Foreground="{StaticResource GuideAccent}"/><TextBlock Margin="7,0,0,0" FontSize="10.5" Foreground="#FFF3F7F9" Text="再次截取此位置"/></StackPanel></Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,11,0,0">
                        <ItemsControl x:Name="ShortcutTipsItems" ItemTemplate="{StaticResource ShortcutTipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="OcrOptionalNote"
                                   Margin="2,0,0,1"
                                   FontSize="10"
                                   Foreground="#FF7893A0"
                                   Text="OCR 为可选离线模块，首次真正使用时再提示安装。"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock x:Name="StepPositionText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="#FF7893A0" Text="01 / 07" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="PreviousButton" Style="{StaticResource GuideButton}" Content="上一步" IsEnabled="False" Click="OnPreviousClick" />
                            <Button x:Name="NextButton" Style="{StaticResource GuidePrimaryButton}" Content="下一步" Click="OnNextClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
