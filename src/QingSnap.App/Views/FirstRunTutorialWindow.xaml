<Window x:Class="QingSnap.App.Views.FirstRunTutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:QingSnap.App.Controls"
        Title="QingSnap 使用向导"
        Icon="pack://application:,,,/QingSnap;component/Assets/QingSnap.ico"
        Width="760"
        Height="680"
        MinWidth="760"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFF3F7F9"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="GuideWindow" Color="#FF091017" />
        <SolidColorBrush x:Key="GuideTitle" Color="#FF0C151D" />
        <SolidColorBrush x:Key="GuidePanel" Color="#FF101B23" />
        <SolidColorBrush x:Key="GuideLine" Color="#46536A76" />
        <SolidColorBrush x:Key="GuideAccent" Color="#FF76DFEE" />
        <SolidColorBrush x:Key="GuideText" Color="#FFF3F7F9" />
        <SolidColorBrush x:Key="GuideMuted" Color="#FF8FA2AD" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style x:Key="GuideStep" TargetType="RadioButton">
            <Setter Property="Height" Value="61" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Background="Transparent" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Rail" Width="4" Height="40" HorizontalAlignment="Left" Background="{StaticResource GuideAccent}" CornerRadius="2" Opacity="0" />
                                <Border x:Name="Marker" Grid.Column="1" Width="29" Height="29" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderBrush="#FF3F6070" BorderThickness="1" CornerRadius="15">
                                    <TextBlock x:Name="StepNumber" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="#FF9BB0BA" Text="{TemplateBinding Tag}" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="StepTitle" FontSize="13" Foreground="#FFDCE8EC" Text="{TemplateBinding Content}" />
                                    <TextBlock x:Name="StepHint" Margin="0,3,0,0" FontSize="10.5" Foreground="#FF71909F" Text="{TemplateBinding ToolTip}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FF10212A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FF132A35" />
                                <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                <Setter TargetName="Marker" Property="Background" Value="{StaticResource GuideAccent}" />
                                <Setter TargetName="Marker" Property="BorderBrush" Value="{StaticResource GuideAccent}" />
                                <Setter TargetName="StepNumber" Property="Foreground" Value="#FF09202A" />
                                <Setter TargetName="StepTitle" Property="Foreground" Value="#FFFFFFFF" />
                                <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="StepHint" Property="Foreground" Value="#FFA7C2CD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GuideButton" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#FFC7D8DF" />
            <Setter Property="Background" Value="#FF0B151C" />
            <Setter Property="BorderBrush" Value="#FF31505E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#FF142630" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.76" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.34" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GuidePrimaryButton" TargetType="Button" BasedOn="{StaticResource GuideButton}">
            <Setter Property="Foreground" Value="#FF09202A" />
            <Setter Property="Background" Value="{StaticResource GuideAccent}" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideAccent}" />
        </Style>

        <Style x:Key="GuideKeycap" TargetType="Border">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="#FF0A151C" />
            <Setter Property="BorderBrush" Value="#FF456471" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="GuideDemoKeycap" TargetType="Border" BasedOn="{StaticResource GuideKeycap}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideAccent}" />
        </Style>

        <DataTemplate x:Key="ShortcutKeyPartTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="4,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9.5" Foreground="#FF7893A0" Text="{Binding Separator}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Separator}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Style="{StaticResource GuideKeycap}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GuideAccent}" Text="{Binding Text}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ShortcutTipTemplate">
            <Border Margin="0,0,8,7" Padding="8,5" Background="#FF101E26" BorderBrush="#FF294653" BorderThickness="1" CornerRadius="5">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding KeyParts}" ItemTemplate="{StaticResource ShortcutKeyPartTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Margin="6,0,0,0" FontSize="10.5" Foreground="#FFC0D0D6" Text="{Binding Text}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="GuideTitleButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF9EB5BF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#FF172630" /><Setter Property="Foreground" Value="#FFFFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="7" Background="{StaticResource GuideWindow}" BorderBrush="#FF3A5967" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Opacity="0.42" ShadowDepth="5" Color="#FF000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource GuideTitle}" BorderBrush="{StaticResource GuideLine}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" Background="#FF132A35" CornerRadius="8">
                            <icons:QingSnapIcon Kind="Capture" Width="17" Height="17" Foreground="{StaticResource GuideAccent}" />
                        </Border>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="QingSnap 使用向导" />
                        <TextBlock x:Name="VersionText" Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="#FF77909C" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GuideTitleButton}" Content="跳过教程" Click="OnFinishClick" />
                        <Button Width="44" Style="{StaticResource GuideTitleButton}" ToolTip="关闭" Click="OnFinishClick">
                            <icons:QingSnapIcon Kind="Close" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="17,25,11,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="9,0,0,16" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GuideAccent}" Text="FIRST FLIGHT / 初次上手" />
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="Step0" Style="{StaticResource GuideStep}" GroupName="GuideSteps" Tag="1" Content="开始截图" ToolTip="F1 唤出截图" IsChecked="True" Checked="OnStepChecked" />
                        <RadioButton x:Name="Step1" Style="{StaticResource GuideStep}" GroupName="GuideSteps" Tag="2" Content="精确选区" ToolTip="像素、比例与尺寸" Checked="OnStepChecked" />
                        <RadioButton x:Name="Step2" Style="{StaticResource GuideStep}" GroupName="GuideSteps" Tag="3" Content="标注编辑" ToolTip="选择、撤销与重做" Checked="OnStepChecked" />
                        <RadioButton x:Name="Step3" Style="{StaticResource GuideStep}" GroupName="GuideSteps" Tag="4" Content="截取长图" ToolTip="自动滚动或手动补截" Checked="OnStepChecked" />
                        <RadioButton x:Name="Step4" Style="{StaticResource GuideStep}" GroupName="GuideSteps" Tag="5" Content="贴到桌面" ToolTip="F3 贴图，M 收纳" Checked="OnStepChecked" />
                        <RadioButton x:Name="Step5" Style="{StaticResource GuideStep}" GroupName="GuideSteps" Tag="6" Content="提取信息" ToolTip="选字与二维码" Checked="OnStepChecked" />
                        <RadioButton x:Name="Step6" Style="{StaticResource GuideStep}" GroupName="GuideSteps" Tag="7" Content="搜索复用" ToolTip="历史与再次截取" Checked="OnStepChecked" />
                    </StackPanel>
                    <Border Grid.Row="2" Margin="9,10,8,0" Padding="0,13,0,0" BorderBrush="{StaticResource GuideLine}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="10.5" Foreground="#FF75909C" TextWrapping="Wrap" Text="以后可在“设置 → 使用教程”重新播放。" />
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource GuideLine}" />

                <Grid Grid.Column="2" Margin="32,26,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Padding="10,5" Background="{StaticResource GuideAccent}" CornerRadius="5">
                            <TextBlock x:Name="StepKeyText" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#FF09202A" Text="F1" />
                        </Border>
                        <TextBlock x:Name="StepKickerText" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GuideAccent}" Text="开始截图" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,16">
                        <TextBlock x:Name="StepTitleText" FontSize="21" FontWeight="SemiBold" Text="按 F1，框住你想要的内容" />
                        <TextBlock x:Name="StepDescriptionText" Margin="0,5,0,0" FontSize="12.5" Foreground="#FFA7BDC6" TextWrapping="Wrap" Text="移动鼠标可直接选中窗口，也可以拖出任意范围。" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="#FFDCE7EA" BorderBrush="#FF6B8D9A" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid x:Name="DemoHost">
                            <Grid x:Name="Demo0" Background="#FF60686D">
                                <Border Margin="28,22" Background="#FFF8FAFB" CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Background="#FFE4EAED" CornerRadius="5,5,0,0">
                                            <StackPanel Margin="12,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="7" Height="7" Margin="0,0,5,0" Background="#FFFF6570" CornerRadius="4" />
                                                <Border Width="7" Height="7" Margin="0,0,5,0" Background="#FFFFC55A" CornerRadius="4" />
                                                <Border Width="7" Height="7" Background="#FF62D28A" CornerRadius="4" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="24,19">
                                            <Border Width="150" Height="11" HorizontalAlignment="Left" Background="#FF9EB0B8" CornerRadius="3" />
                                            <Border Height="7" Margin="0,14,0,0" Background="#FFD3DDE1" CornerRadius="3" />
                                            <Border Width="265" Height="7" Margin="0,9,0,0" HorizontalAlignment="Left" Background="#FFD3DDE1" CornerRadius="3" />
                                            <Border Height="58" Margin="0,15,0,0" Background="#FFC3D7DD" CornerRadius="4" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="CaptureDimmer" Background="#75091017" Opacity="0" />
                                <Canvas ClipToBounds="True">
                                    <Border x:Name="SmartRecognitionFrame" Panel.ZIndex="10" Canvas.Left="46" Canvas.Top="40" Width="360" Height="198" BorderBrush="{StaticResource GuideAccent}" BorderThickness="2" CornerRadius="4" Opacity="0" />
                                    <Border x:Name="CaptureSelection" Panel.ZIndex="20" Canvas.Left="86" Canvas.Top="60" Width="1" Height="1" Background="#FFF8FAFB" BorderBrush="{StaticResource GuideAccent}" BorderThickness="2" ClipToBounds="True">
                                        <StackPanel Margin="20,18">
                                            <Border Width="130" Height="10" HorizontalAlignment="Left" Background="#FF9EB0B8" CornerRadius="3" />
                                            <Border Height="7" Margin="0,13,0,0" Background="#FFD3DDE1" CornerRadius="3" />
                                            <Border Width="205" Height="7" Margin="0,10,0,0" HorizontalAlignment="Left" Background="#FFD3DDE1" CornerRadius="3" />
                                            <Border Height="48" Margin="0,14,0,0" Background="#FFC3D7DD" CornerRadius="3" />
                                        </StackPanel>
                                    </Border>
                                    <Path x:Name="CaptureCursor" Panel.ZIndex="50" Canvas.Left="34" Canvas.Top="34" Width="22" Height="22" Stretch="Uniform" Fill="#FFF7FBFC" Stroke="#FF26333A" StrokeThickness="1" Data="M2,1 L2,20 L7.3,15.1 L11.2,22 L14.2,20.4 L10.4,13.5 L17.5,13.1 Z" />
                                    <Border x:Name="CaptureSmartHint" Panel.ZIndex="40" Canvas.Left="57" Canvas.Top="48" Padding="8,5" Background="#E60A1720" CornerRadius="4" Opacity="0">
                                        <TextBlock FontSize="10.5" Foreground="{StaticResource GuideAccent}" Text="单击 · 智能选区" />
                                    </Border>
                                    <Border x:Name="CaptureDragHint" Panel.ZIndex="40" Canvas.Left="86" Canvas.Top="30" Padding="8,5" Background="#E60A1720" CornerRadius="4" Opacity="0">
                                        <TextBlock FontSize="10.5" Foreground="{StaticResource GuideAccent}" Text="拖动 · 自由框选" />
                                    </Border>
                                    <Border x:Name="CaptureSize" Panel.ZIndex="40" Canvas.Left="86" Canvas.Top="241" Padding="8,5" Background="#FF0A1720" CornerRadius="4" Opacity="0">
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource GuideAccent}" Text="680 × 453 px" />
                                    </Border>
                                    <Border x:Name="CaptureToolbar" Panel.ZIndex="40" Canvas.Left="222" Canvas.Top="241" Height="31" Padding="8,0" Background="#FF0B171F" BorderBrush="#FF355665" BorderThickness="1" CornerRadius="5" Opacity="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:QingSnapIcon Kind="Pen" Width="14" Height="14" Margin="4" Foreground="#FFFF6470" />
                                            <icons:QingSnapIcon Kind="Rectangle" Width="14" Height="14" Margin="4" Foreground="#FFFF6470" />
                                            <icons:QingSnapIcon Kind="LongCapture" Width="14" Height="14" Margin="4" Foreground="{StaticResource GuideAccent}" />
                                            <icons:QingSnapIcon Kind="Confirm" Width="14" Height="14" Margin="4" Foreground="{StaticResource GuideAccent}" />
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>

                            <Grid x:Name="Demo1" Visibility="Collapsed" Background="#FF60686D">
                                <Border Margin="23,18" Background="#FFF8FAFB" CornerRadius="5" />
                                <Border Background="#5C091017" />
                                <Canvas ClipToBounds="True">
                                    <Border x:Name="PrecisionSelection" Panel.ZIndex="20" Canvas.Left="70" Canvas.Top="60" Width="230" Height="144" Background="#FFF8FAFB" BorderBrush="{StaticResource GuideAccent}" BorderThickness="2" ClipToBounds="True">
                                        <Grid>
                                            <StackPanel Margin="18,17">
                                                <Border Width="115" Height="9" HorizontalAlignment="Left" Background="#FFAABAC1" CornerRadius="3" />
                                                <Border Height="6" Margin="0,12,0,0" Background="#FFD6E0E4" CornerRadius="3" />
                                                <Border Width="165" Height="6" Margin="0,8,0,0" HorizontalAlignment="Left" Background="#FFD6E0E4" CornerRadius="3" />
                                                <Border Height="38" Margin="0,12,0,0" Background="#FFC5D9DE" CornerRadius="3" />
                                            </StackPanel>
                                            <Grid x:Name="PrecisionHandles">
                                                <Border Width="8" Height="8" Margin="-5" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource GuideAccent}" BorderBrush="#FF0A1720" BorderThickness="1" />
                                                <Border Width="8" Height="8" Margin="-5" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource GuideAccent}" BorderBrush="#FF0A1720" BorderThickness="1" />
                                                <Border Width="8" Height="8" Margin="-5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource GuideAccent}" BorderBrush="#FF0A1720" BorderThickness="1" />
                                                <Border Width="8" Height="8" Margin="-5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource GuideAccent}" BorderBrush="#FF0A1720" BorderThickness="1" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Path x:Name="PrecisionCursor" Panel.ZIndex="50" Canvas.Left="296" Canvas.Top="199" Width="21" Height="21" Stretch="Uniform" Fill="#FFF7FBFC" Stroke="#FF26333A" StrokeThickness="1" Data="M2,1 L2,20 L7.3,15.1 L11.2,22 L14.2,20.4 L10.4,13.5 L17.5,13.1 Z" />
                                    <Border x:Name="PrecisionRatioBadge" Panel.ZIndex="30" Canvas.Left="354" Canvas.Top="30" Padding="9,5" Background="#E60A1720" BorderBrush="#FF355665" BorderThickness="1" CornerRadius="4">
                                        <TextBlock x:Name="PrecisionRatioText" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource GuideAccent}" Text="自由" />
                                    </Border>
                                    <Border x:Name="PrecisionLockBadge" Panel.ZIndex="30" Canvas.Left="354" Canvas.Top="68" Padding="8,5" Background="#E60A1720" CornerRadius="4" Opacity="0">
                                        <StackPanel Orientation="Horizontal"><icons:QingSnapIcon Kind="Lock" Width="13" Height="13" Foreground="{StaticResource GuideAccent}"/><TextBlock Margin="6,0,0,0" FontSize="10.5" Foreground="#FFF3F7F9" Text="尺寸已锁定"/></StackPanel>
                                    </Border>
                                    <Border x:Name="PrecisionMagnifier" Panel.ZIndex="30" Canvas.Left="365" Canvas.Top="112" Width="82" Height="72" Background="#FF0A1720" BorderBrush="{StaticResource GuideAccent}" BorderThickness="1" CornerRadius="5" Opacity="0">
                                        <Grid Margin="6">
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions>
                                            <Grid Background="#FFE8EEF0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <Border Grid.Row="0" Grid.Column="0" Background="#FFF8FAFB"/><Border Grid.Row="0" Grid.Column="1" Background="#FFB9D7DE"/><Border Grid.Row="1" Grid.Column="0" Background="#FFDDE8EB"/><Border Grid.Row="1" Grid.Column="1" Background="#FF8EB7C1"/>
                                                <Grid x:Name="PrecisionPixelCrosshair" Grid.RowSpan="2" Grid.ColumnSpan="2">
                                                    <Grid.RenderTransform><TranslateTransform x:Name="PrecisionPixelMove"/></Grid.RenderTransform>
                                                    <Border Width="1" Background="#FFFF4E5B"/><Border Height="1" Background="#FFFF4E5B"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontFamily="Consolas" FontSize="9.5" Foreground="{StaticResource GuideAccent}" Text="D · +1 px" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="PrecisionGeometryPanel" Panel.ZIndex="30" Canvas.Left="30" Canvas.Top="229" Height="43" Padding="9,5" Background="#F20A1720" BorderBrush="#FF355665" BorderThickness="1" CornerRadius="5">
                                        <Grid Width="292">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock FontSize="8.5" Foreground="#FF7F98A4" Text="X"/><TextBlock x:Name="PrecisionXText" FontFamily="Consolas" FontSize="10.5" Foreground="#FFF3F7F9" Text="70"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock FontSize="8.5" Foreground="#FF7F98A4" Text="Y"/><TextBlock x:Name="PrecisionYText" FontFamily="Consolas" FontSize="10.5" Foreground="#FFF3F7F9" Text="60"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock FontSize="8.5" Foreground="#FF7F98A4" Text="W"/><TextBlock x:Name="PrecisionWText" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource GuideAccent}" Text="230"/></StackPanel>
                                            <StackPanel Grid.Column="3"><TextBlock FontSize="8.5" Foreground="#FF7F98A4" Text="H"/><TextBlock x:Name="PrecisionHText" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource GuideAccent}" Text="144"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Grid>

                            <Grid x:Name="Demo2" Visibility="Collapsed" Background="#FFF8FAFB">
                                <Canvas ClipToBounds="True">
                                    <Border Canvas.Left="48" Canvas.Top="28" Width="355" Height="190" BorderBrush="#FF76DFEE" BorderThickness="1" />
                                    <Canvas x:Name="AnnotationGroup" Panel.ZIndex="20" Canvas.Left="48" Canvas.Top="28" Width="355" Height="190">
                                        <Canvas.RenderTransform><TranslateTransform x:Name="AnnotationGroupMove" /></Canvas.RenderTransform>
                                        <Path x:Name="AnnotationArrow" Canvas.Left="42" Canvas.Top="56" Width="145" Height="82" Stretch="Fill" Fill="#FFFF4E5B" Opacity="0" Data="M1,78 L108,18 L101,8 L144,1 L122,38 L115,28 Z" RenderTransformOrigin="0,1">
                                            <Path.RenderTransform><ScaleTransform x:Name="AnnotationScale" ScaleX="0" ScaleY="0" /></Path.RenderTransform>
